<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Verifikasi Email Qifaya</title>
  </head>
  <body style="margin:0;padding:0;background-color:#0f0f10;font-family:'Segoe UI',Arial,sans-serif;">

    <!-- Wrapper -->
    <table width="100%" cellpadding="0" cellspacing="0" style="background-color:#0f0f10;padding:40px 0;">
      <tr>
        <td align="center">

          <!-- Card -->
          <table width="560" cellpadding="0" cellspacing="0"
            style="background:linear-gradient(145deg,#1a1a2e,#16213e);border-radius:20px;overflow:hidden;box-shadow:0 20px 60px rgba(0,0,0,0.5);max-width:560px;width:100%;">

            <!-- Header Gradient Bar -->
            <tr>
              <td style="background:linear-gradient(90deg,#6c63ff,#a855f7,#ec4899);height:5px;"></td>
            </tr>

            <!-- Header -->
            <tr>
              <td align="center" style="padding:40px 40px 24px;">
                <div style="display:inline-block;background:linear-gradient(135deg,#6c63ff,#a855f7);border-radius:16px;padding:12px 24px;">
                  <span style="font-size:22px;font-weight:800;color:#ffffff;letter-spacing:2px;text-transform:uppercase;">
                    QIFAYA
                  </span>
                </div>
              </td>
            </tr>

            <!-- Greeting Icon -->
            <tr>
              <td align="center" style="padding:0 40px 8px;">
                <div style="font-size:48px;">👋</div>
              </td>
            </tr>

            <!-- Title -->
            <tr>
              <td align="center" style="padding:0 40px 12px;">
                <h1 style="margin:0;font-size:26px;font-weight:700;color:#ffffff;line-height:1.3;">
                  Halo, {{name}}!
                </h1>
              </td>
            </tr>

            <!-- Subtitle -->
            <tr>
              <td align="center" style="padding:0 40px 32px;">
                <p style="margin:0;font-size:15px;color:#a0aec0;line-height:1.7;max-width:400px;">
                  Terima kasih sudah bergabung di <strong style="color:#a855f7;">Qifaya</strong>. 
                  Satu langkah lagi — klik tombol di bawah untuk memverifikasi email kamu dan 
                  mulai menjelajahi semua fitur kami.
                </p>
              </td>
            </tr>

            <!-- CTA Button -->
            <tr>
              <td align="center" style="padding:0 40px 40px;">
                <a href="{{url}}"
                  style="display:inline-block;padding:16px 48px;background:linear-gradient(135deg,#6c63ff,#a855f7);color:#ffffff;text-decoration:none;font-size:16px;font-weight:700;border-radius:50px;letter-spacing:0.5px;box-shadow:0 8px 32px rgba(108,99,255,0.4);">
                  Verifikasi Sekarang
                </a>
              </td>
            </tr>

            <!-- Divider -->
            <tr>
              <td style="padding:0 40px;">
                <div style="border-top:1px solid rgba(255,255,255,0.07);"></div>
              </td>
            </tr>

            <!-- Security Note -->
            <tr>
              <td align="center" style="padding:24px 40px;">
                <p style="margin:0;font-size:13px;color:#718096;line-height:1.6;">
                  Kalau kamu tidak mendaftar di Qifaya, abaikan email ini saja.
                  Tombol di atas akan kadaluarsa jika tidak digunakan.
                </p>
              </td>
            </tr>

            <!-- Footer Bar -->
            <tr>
              <td style="background:rgba(0,0,0,0.3);padding:20px 40px;">
                <table width="100%" cellpadding="0" cellspacing="0">
                  <tr>
                    <td align="center">
                      <p style="margin:0;font-size:12px;color:#4a5568;">
                        © 2025 Qifaya — All rights reserved.
                      </p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>

            <!-- Bottom Gradient Bar -->
            <tr>
              <td style="background:linear-gradient(90deg,#ec4899,#a855f7,#6c63ff);height:3px;"></td>
            </tr>

          </table>
          <!-- /Card -->

        </td>
      </tr>
    </table>
    <!-- /Wrapper -->

  </body>
</html>